<UserControl x:Class="KClevoPanel.App.FanPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:KClevoPanel.App">
 <StackPanel Spacing="16">
  <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="False" Severity="Informational"/>
  <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
   <StackPanel Spacing="10"><Grid><TextBlock Text="风扇模式" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock x:Name="ModeLabel" Text="读取中" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/></Grid>
    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <ToggleButton x:Name="AutoMode" Tag="0" Click="ModeClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,10"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE895;" FontSize="16"/><TextBlock Text="自动"/></StackPanel></ToggleButton>
     <ToggleButton x:Name="MaxMode" Tag="1" Grid.Column="1" Click="ModeClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,10"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE9D9;" FontSize="16"/><TextBlock Text="最大风量"/></StackPanel></ToggleButton>
     <ToggleButton x:Name="CustomMode" Tag="6" Grid.Column="2" Click="ApplyClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,10" ToolTipService.ToolTip="应用下方曲线，保持至退出或恢复"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE713;" FontSize="16"/><TextBlock Text="自定义"/></StackPanel></ToggleButton>
    </Grid>
    <StackPanel x:Name="BusyPanel" Visibility="Collapsed" Orientation="Horizontal" Spacing="10"><ProgressRing x:Name="ModeProgress" Width="20" Height="20"/><TextBlock x:Name="BusyText" Text="正在切换并核对固件状态…" VerticalAlignment="Center" FontSize="12"/></StackPanel>
    <TextBlock Text="自定义在程序运行期间保持；退出、心跳中断或睡眠恢复时，独立进程恢复进入前的设置。" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
   </StackPanel>
  </Border>
  <Grid x:Name="Editors" ColumnSpacing="16" RowSpacing="16" SizeChanged="EditorsSizeChanged"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><local:FanCurveEditor x:Name="CpuEditor" IsEnabled="False"/><local:FanCurveEditor x:Name="GpuEditor" IsEnabled="False" Grid.Column="1"/></Grid>
  <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20,16">
   <StackPanel Spacing="10"><TextBlock x:Name="DraftLabel" Text="尚未读取曲线" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"/><TextBlock x:Name="TrialLabel" Text="拖动中间节点，或输入精确数值。保存草稿不会控制风扇。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="ResetButton" Click="ResetClicked" Content="重置编辑"/><Button x:Name="TryButton" Click="TryClicked" Content="试用 30 秒"/><Button x:Name="ApplyButton" Click="ApplyClicked" Style="{StaticResource AccentButtonStyle}" Content="应用曲线"/><Button x:Name="KeepButton" Click="KeepClicked" Content="保持此曲线" Visibility="Collapsed"/><Button x:Name="StopButton" Click="StopClicked" Visibility="Collapsed" Content="停止并恢复"/></StackPanel>

   </StackPanel>
  </Border>
  <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><Expander.Header><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE946;" FontSize="16"/><TextBlock Text="控制范围与诊断"/></StackPanel></Expander.Header><StackPanel Spacing="8"><TextBlock Text="自动与最大风量直接设置固件模式；自定义由 EC 按曲线调速。仅调节中间节点，占空比至少 30%；固件首尾节点锁定。低温时固件可能让风扇停转。" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="两路曲线写后逐节点核对；模式状态区分固件应答与保存记录。高温停转、遥测无效、外部设置变化或心跳中断时尝试恢复；内核挂起、断电等情况下不能保证恢复。偏移、强冷和未知功能分支暂不开放。" FontSize="12" TextWrapping="Wrap"/><TextBlock x:Name="SessionLabel" Text="启动时不自动应用曲线，不安装驱动。" FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Expander>
 </StackPanel>
</UserControl>
