<Window x:Class="KClevoPanel.App.MiniWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:KClevoPanel.App">
 <Border x:Name="MiniRoot" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
  <StackPanel Spacing="14">
   <Grid><TextBlock Text="KClevoPanel" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="Stamp" Text="实时状态" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
   <Grid ColumnSpacing="20" RowSpacing="16">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
    <StackPanel Spacing="6">
     <Grid><TextBlock Text="CPU" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="Cpu" Text="—" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
     <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="CpuModel" Text="型号读取中" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="CpuTemperature" Grid.Column="1" Text="— °C" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     </Grid>
     <local:HistoryChart x:Name="CpuGraph" Height="76" LineBrush="{ThemeResource CpuGraphBrush}"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Spacing="6">
     <Grid><TextBlock Text="内存" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="Memory" Text="—" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
     <TextBlock x:Name="MemoryDetail" Text="物理内存" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <local:HistoryChart x:Name="MemoryGraph" Height="76" LineBrush="{ThemeResource MemoryGraphBrush}"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Spacing="6">
     <Grid><TextBlock Text="GPU" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="Gpu" Text="—" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
     <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="GpuModel" Text="型号读取中" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="GpuTemperature" Grid.Column="1" Text="— °C" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     </Grid>
     <local:HistoryChart x:Name="GpuGraph" Height="76" LineBrush="{ThemeResource GpuGraphBrush}"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
     <Grid><TextBlock Text="电池" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="Battery" Text="—" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
     <TextBlock x:Name="BatteryDetail" Text="供电状态读取中" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <local:HistoryChart x:Name="BatteryGraph" Height="76" LineBrush="{ThemeResource BatteryGraphBrush}"/>
    </StackPanel>
   </Grid>
   <TextBlock x:Name="Details" Text="GPU 功耗 — W · 频率 — MHz" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
   <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
   <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <local:PresetSelector x:Name="MiniPresets"/>
    <Button Grid.Column="1" Width="36" Height="38" Padding="0" Click="OpenClicked" ToolTipService.ToolTip="打开主窗口" AutomationProperties.Name="打开主窗口"><FontIcon Glyph="&#xE8A7;" FontSize="16"/></Button>
   </Grid>
   <Grid ColumnSpacing="5"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><FontIcon x:Name="PresetSuccessIcon" Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="Collapsed"/><TextBlock Grid.Column="1" x:Name="Thermals" Text="风扇通道连接中" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></Grid>
  </StackPanel>
 </Border>
</Window>
