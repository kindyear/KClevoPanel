<Window x:Class="KClevoPanel.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:KClevoPanel.App">
 <Grid x:Name="Root" Background="Transparent">
  <Grid.Resources>
   <Style x:Key="CardStyle" TargetType="Border"><Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="24"/></Style>
   <Style x:Key="CaptionButtonStyle" TargetType="Button"><Setter Property="Width" Value="46"/><Setter Property="Height" Value="48"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="0"/></Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Background="Transparent">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid x:Name="TitleDragRegion" Padding="22,0" ColumnSpacing="12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <FontIcon Glyph="&#xE9D9;" FontSize="18" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="1" Text="KClevoPanel" FontSize="13"  FontWeight="SemiBold" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="2" Text="实时监测 · 独立档位" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center"/>
   </Grid>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
    <Button Style="{StaticResource CaptionButtonStyle}" Click="MinimizeClicked" ToolTipService.ToolTip="最小化"><FontIcon Glyph="&#xE921;" FontSize="10"/></Button>
    <Button Style="{StaticResource CaptionButtonStyle}" Click="MaximizeClicked" ToolTipService.ToolTip="最大化 / 还原"><FontIcon Glyph="&#xE922;" FontSize="10"/></Button>
    <Button Style="{StaticResource CaptionButtonStyle}" Click="HideClicked" ToolTipService.ToolTip="收起到托盘"><FontIcon Glyph="&#xE8BB;" FontSize="12"/></Button>
   </StackPanel>
  </Grid>
  <NavigationView x:Name="Navigation" Grid.Row="1" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
     PaneDisplayMode="Left" OpenPaneLength="220" CompactPaneLength="48" IsPaneOpen="True" IsPaneToggleButtonVisible="True" PaneOpening="PaneOpening" PaneClosing="PaneClosing" SelectionChanged="NavigationChanged">
   <NavigationView.Resources><SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/></NavigationView.Resources><NavigationView.PaneHeader><StackPanel x:Name="SidebarBrand" Margin="16,12,16,24" Spacing="6"><TextBlock Text="设备中心" Style="{ThemeResource SubtitleTextBlockStyle}"/><TextBlock Text="COLORFUL X17" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></NavigationView.PaneHeader>
   <NavigationView.FooterMenuItems><NavigationViewItem x:Name="SettingsItem" Content="设置" Tag="settings" Icon="Setting"/></NavigationView.FooterMenuItems>
   <NavigationView.MenuItems>
    <NavigationViewItem x:Name="OverviewItem" Content="性能概览" Tag="overview" Icon="Home"/>
    <NavigationViewItem Content="设备信息" Tag="device" Icon="AllApps"/>
    <NavigationViewItem x:Name="FanItem" Content="散热控制" Tag="fans"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9CA;"/></NavigationViewItem.Icon></NavigationViewItem>
   </NavigationView.MenuItems>
   <ScrollViewer x:Name="ContentScroll">
    <StackPanel Padding="32,24,32,32" Spacing="24">
     <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Spacing="8"><TextBlock x:Name="PageTitle" Text="性能概览" Style="{ThemeResource TitleTextBlockStyle}"/>
       <TextBlock x:Name="UpdateLabel" TextTrimming="CharacterEllipsis" Text="准备读取…" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
      <StackPanel x:Name="HeaderActions" Grid.Column="1" Spacing="6" VerticalAlignment="Center">
       <StackPanel Orientation="Horizontal" Spacing="8"><local:PresetSelector x:Name="MainPresets" Width="336"/><Button x:Name="RefreshButton" Click="RefreshClicked" ToolTipService.ToolTip="刷新"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="14"/><TextBlock x:Name="RefreshText" Text="刷新"/></StackPanel></Button></StackPanel>
       <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right"><FontIcon x:Name="PresetSuccessIcon" Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="Collapsed"/><TextBlock x:Name="PresetStatus" Text="读取固件档位…" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="380" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"/></StackPanel>
      </StackPanel>
     </Grid>
     <InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="True" Severity="Warning" Title="部分信息暂不可用"/>
     <StackPanel x:Name="OverviewPanel" Spacing="16">
      <Grid ColumnSpacing="16" RowSpacing="16">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
       <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="8">
         <Grid><TextBlock Text="CPU" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock x:Name="CpuValue" Text="—" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
         <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="CpuName" Text="处理器使用率" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="CpuTemperature" Grid.Column="1" Text="温度读取中" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
         </Grid>
         <Grid Height="112"><local:HistoryChart x:Name="CpuChart" LineBrush="{ThemeResource CpuGraphBrush}"/></Grid>
        </StackPanel>
       </Border>
       <Border Grid.Column="1" Style="{StaticResource CardStyle}">
        <StackPanel Spacing="8">
         <Grid><TextBlock Text="内存" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock x:Name="MemoryValue" Text="—" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
         <TextBlock x:Name="MemoryDetail" Text="物理内存" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
         <Grid Height="112"><local:HistoryChart x:Name="MemoryChart" LineBrush="{ThemeResource MemoryGraphBrush}"/></Grid>
        </StackPanel>
       </Border>
       <Border Grid.Row="1" Style="{StaticResource CardStyle}">
        <StackPanel Spacing="8">
         <Grid><TextBlock Text="GPU" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock x:Name="GpuValue" Text="—" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
         <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="GpuName" Text="型号读取中" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="GpuTemperature" Grid.Column="1" Text="— °C" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
         </Grid>
         <Grid Height="112"><local:HistoryChart x:Name="GpuChart" LineBrush="{ThemeResource GpuGraphBrush}"/></Grid>
         <TextBlock x:Name="GpuDetail" Text="功耗 — W · 频率 — MHz" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
       </Border>
       <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}">
        <StackPanel Spacing="8">
         <Grid><TextBlock Text="电池" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock x:Name="BatteryValue" Text="—" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
         <TextBlock x:Name="BatteryDetail" Text="电量 · 供电状态" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
         <Grid Height="112"><local:HistoryChart x:Name="BatteryChart" LineBrush="{ThemeResource BatteryGraphBrush}"/></Grid>
        </StackPanel>
       </Border>
      </Grid>
      <Border Style="{StaticResource CardStyle}" Padding="24,20">
       <StackPanel Spacing="10">
        <TextBlock Text="风扇转速" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
        <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel Spacing="6"><Grid><TextBlock Text="CPU 风扇" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="CpuFanValue" Text="—" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid><local:HistoryChart x:Name="CpuFanChart" Height="96" LineBrush="{ThemeResource CpuGraphBrush}"/></StackPanel>
         <StackPanel Grid.Column="1" Spacing="6"><Grid><TextBlock Text="GPU 风扇" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="GpuFanValue" Text="—" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid><local:HistoryChart x:Name="GpuFanChart" Height="96" LineBrush="{ThemeResource GpuGraphBrush}"/></StackPanel>
        </Grid>
        <TextBlock x:Name="FanState" Text="只读通道连接中" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
       </StackPanel>
      </Border>
     </StackPanel>
     <StackPanel x:Name="DevicePanel" Visibility="Collapsed"><local:HardwarePage x:Name="HardwareDetails"/></StackPanel>
     <StackPanel x:Name="FanPanel" Visibility="Collapsed"><local:FanPage x:Name="Fans"/></StackPanel>
     <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Spacing="10">
      <TextBlock Text="启动与后台" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
      <Border Style="{StaticResource CardStyle}" Padding="20,16"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE7E8;" FontSize="20" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="开机自启动" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock x:Name="StartupDescription" Text="登录 Windows 后在托盘运行；系统若禁用此启动项，可在任务管理器中启用。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="重复启动自动打开已有窗口，不重复运行；自启动不自动应用控制设置。" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><ToggleSwitch x:Name="StartupToggle" Grid.Column="2" Toggled="StartupToggled" AutomationProperties.Name="开机自启动" VerticalAlignment="Center" OffContent="关闭" OnContent="开启"/></Grid></Border>
      <TextBlock Text="外观" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,2"/><Border Style="{StaticResource CardStyle}" Padding="20,16"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE790;" FontSize="20" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="应用主题" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock Text="主窗口与托盘面板同步切换。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><Grid Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"><ComboBox x:Name="ThemeChooser" AutomationProperties.Name="应用主题" Width="154" SelectedIndex="0" SelectionChanged="ThemeChanged"><ComboBoxItem Content="跟随 Windows"/><ComboBoxItem Content="浅色"/><ComboBoxItem Content="深色"/></ComboBox></Grid></Grid></Border><TextBlock Text="数据监测" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,14,0,2"/><Border Style="{StaticResource CardStyle}" Padding="20,16"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE9D9;" FontSize="20" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="系统与显卡" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock Text="CPU、内存、电池和 NVIDIA 指标的采样间隔。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><Grid Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"><ComboBox x:Name="SystemFrequencyChooser" Width="154" AutomationProperties.Name="系统与显卡采样间隔" SelectedIndex="1" SelectionChanged="FrequencyChanged"><ComboBoxItem Content="250 毫秒"/><ComboBoxItem Content="500 毫秒"/><ComboBoxItem Content="1 秒"/><ComboBoxItem Content="2 秒"/></ComboBox></Grid></Grid></Border><Border Style="{StaticResource CardStyle}" Padding="20,16"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE823;" FontSize="20" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="温度与风扇" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock Text="独立采样，较长间隔可减少后台读取。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><Grid Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"><ComboBox x:Name="ThermalFrequencyChooser" Width="154" AutomationProperties.Name="温度与风扇采样间隔" SelectedIndex="0" SelectionChanged="FrequencyChanged"><ComboBoxItem Content="1 秒"/><ComboBoxItem Content="2 秒"/><ComboBoxItem Content="5 秒"/></ComboBox></Grid></Grid></Border><TextBlock x:Name="SamplingSummary" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="4,0,0,0"/><TextBlock Text="诊断和信息" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,14,0,2"/><Expander IsExpanded="False" x:Name="ChannelExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><Expander.Header><StackPanel Orientation="Horizontal" Spacing="16"><FontIcon Glyph="&#xE71B;" FontSize="20"/><StackPanel Spacing="3"><TextBlock Text="读取通道" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock Text="查看数据来源与本机接口库" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></StackPanel></Expander.Header><StackPanel Spacing="14"><TextBlock Text="系统指标由 Windows API 读取，显卡指标来自 NVIDIA NVML；温度与风扇使用独立只读进程。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="ChannelDetails" Text="读取通道信息…" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12"/></StackPanel></Expander><Button x:Name="AboutButton" Click="AboutClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20,18"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE946;" FontSize="20"/><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="关于 KClevoPanel" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock Text="版本、应用介绍与技术信息" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"/></Grid></Button></StackPanel>
     <StackPanel x:Name="AboutPanel" Visibility="Collapsed" Spacing="20">
 <Button Click="BackToSettingsClicked" Padding="12,7"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72B;" FontSize="12"/><TextBlock Text="返回设置"/></StackPanel></Button>
 <Border Style="{StaticResource CardStyle}" Padding="32"><Grid RowSpacing="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Width="80" Height="80" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="20"><FontIcon Glyph="&#xE9D9;" FontSize="36" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/></Border>
   <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center"><TextBlock Text="KClevoPanel" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="让设备状态，一目了然。" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><StackPanel Orientation="Horizontal" Spacing="8" Margin="0,5,0,0"><Border Padding="9,3" CornerRadius="5" Background="{ThemeResource ControlFillColorSecondaryBrush}"><TextBlock x:Name="AboutVersion" Text="版本 0.9.0" FontSize="11"/></Border><Border Padding="9,3" CornerRadius="5" Background="{ThemeResource ControlFillColorSecondaryBrush}"><TextBlock Text="Windows · x64" FontSize="11"/></Border></StackPanel></StackPanel>
  </Grid>
  <TextBlock Grid.Row="1" Text="为 COLORFUL X17 打造的轻量设备面板。实时查看性能、温度与风扇，在桌面与托盘之间自由切换。" TextWrapping="Wrap" FontSize="14" LineHeight="23" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
 </Grid></Border>
 <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Style="{StaticResource CardStyle}" Padding="24"><StackPanel Spacing="12"><FontIcon Glyph="&#xE9D9;" FontSize="24" HorizontalAlignment="Left" Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/><TextBlock Text="实时，清晰，轻量" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock Text="60 秒性能曲线与独立采样，让每一次变化都清晰可见。" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Border>
  <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="24"><StackPanel Spacing="12"><PathIcon Data="M12,1 L23,5 L21,15 C20,20 15,24 12,26 C8,24 3,20 2,15 L0,5 Z M6,12 L10,17 L19,8 L17,6 L10,13 L8,10 Z" Width="24" Height="24" HorizontalAlignment="Left" Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/><TextBlock Text="数据留在本机" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock Text="不上传设备数据，不读取硬件序列号；导出由你主动发起。" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Border>
 </Grid>
 <Border Style="{StaticResource CardStyle}" Padding="24"><StackPanel Spacing="16"><TextBlock Text="为这台设备而构建" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock Text="COLORFUL X17 AT 23H2 · Intel Core i7-13650HX · NVIDIA RTX 4060 Laptop" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/><TextBlock Text="基于 .NET 8 与 WinUI 3。感谢 Clevo-X370-Control-Center 项目提供的公开研究，以及 Microsoft Windows App SDK 与 NVIDIA NVML。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="固件档位通过本机驱动接口控制，仍需要现有 ACPI 驱动。它不包含原厂预设的完整 GPU 与 Windows 电源联动。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Border>
 <TextBlock Text="原生 Windows 体验 · 本机数据处理" FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,4,0,4"/>
</StackPanel>
    </StackPanel>
   </ScrollViewer>
  </NavigationView>
 </Grid>
</Window>
