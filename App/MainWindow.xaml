<Window x:Class="KClevoPanel.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:KClevoPanel.App">
 <Grid x:Name="Root" Background="Transparent">
  <Grid.Resources>
   <Style x:Key="CardStyle" TargetType="Border"><Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="24"/></Style>
   <Style x:Key="CaptionButtonStyle" TargetType="Button"><Setter Property="Width" Value="46"/><Setter Property="Height" Value="48"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="0"/></Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Background="Transparent">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid x:Name="TitleDragRegion" Padding="22,0" ColumnSpacing="12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <FontIcon Glyph="&#xE9D9;" FontSize="18" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="1" Text="KClevoPanel" FontSize="13"  FontWeight="SemiBold" VerticalAlignment="Center"/>

   </Grid>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
    <Button Style="{StaticResource CaptionButtonStyle}" Click="MinimizeClicked" ToolTipService.ToolTip="最小化"><FontIcon Glyph="&#xE921;" FontSize="10"/></Button>
    <Button Style="{StaticResource CaptionButtonStyle}" Click="MaximizeClicked" ToolTipService.ToolTip="最大化 / 还原"><FontIcon Glyph="&#xE922;" FontSize="10"/></Button>
    <Button Style="{StaticResource CaptionButtonStyle}" Click="HideClicked" ToolTipService.ToolTip="收起到托盘"><FontIcon Glyph="&#xE8BB;" FontSize="12"/></Button>
   </StackPanel>
  </Grid>
  <NavigationView x:Name="Navigation" Grid.Row="1" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
     PaneDisplayMode="Left" OpenPaneLength="220" CompactPaneLength="48" IsPaneOpen="True" IsPaneToggleButtonVisible="True" PaneOpening="PaneOpening" PaneClosing="PaneClosing" SelectionChanged="NavigationChanged">
   <NavigationView.Resources><SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/></NavigationView.Resources><NavigationView.PaneHeader><StackPanel x:Name="SidebarBrand" Margin="16,12,16,24" Spacing="6"><TextBlock Text="设备中心" Style="{ThemeResource SubtitleTextBlockStyle}"/><TextBlock Text="COLORFUL X17" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></NavigationView.PaneHeader>
   <NavigationView.FooterMenuItems><NavigationViewItem x:Name="SettingsItem" Content="设置" Tag="settings" Icon="Setting"/></NavigationView.FooterMenuItems>
   <NavigationView.MenuItems>
    <NavigationViewItem x:Name="OverviewItem" Content="性能概览" Tag="overview" Icon="Home"/>
    <NavigationViewItem Content="设备信息" Tag="device" Icon="AllApps"/>
    <NavigationViewItem x:Name="FanItem" Content="散热控制" Tag="fans"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9CA;"/></NavigationViewItem.Icon></NavigationViewItem>
   </NavigationView.MenuItems>
   <ScrollViewer x:Name="ContentScroll">
    <StackPanel x:Name="PageContent" Padding="32,24,32,32" Spacing="24"><StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
     <Grid x:Name="PageHeader" ColumnSpacing="16" RowSpacing="12" SizeChanged="PageHeaderSizeChanged"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Spacing="8"><TextBlock x:Name="PageTitle" Text="性能概览" Style="{ThemeResource TitleTextBlockStyle}"/><TextBlock x:Name="UpdateLabel" Text="准备读取…" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
      <StackPanel x:Name="HeaderActions" Grid.Column="1" Spacing="6"><local:PresetSelector x:Name="MainPresets" Width="336"/><StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right"><ProgressRing x:Name="PresetProgress" Width="14" Height="14" Visibility="Collapsed"/><FontIcon x:Name="PresetSuccessIcon" Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="Collapsed"/><TextBlock x:Name="PresetStatus" Text="读取固件档位…" FontSize="11" MaxWidth="300" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></StackPanel>
      <Button x:Name="RefreshButton" Grid.Column="2" Width="40" Height="40" Padding="0" VerticalAlignment="Top" Click="RefreshClicked" ToolTipService.ToolTip="刷新" AutomationProperties.Name="刷新当前页面"><FontIcon Glyph="&#xE72C;" FontSize="16"/></Button>
     </Grid>
     <InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="True" Severity="Warning" Title="部分信息暂不可用"/>
     <StackPanel x:Name="OverviewPanel" Spacing="16">
      <Grid ColumnSpacing="16" RowSpacing="16">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
       <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="8">
         <Grid><TextBlock Text="CPU" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock x:Name="CpuValue" Text="—" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
         <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="CpuName" Text="处理器使用率" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="CpuTemperature" Grid.Column="1" Text="温度读取中" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
         </Grid>
         <Grid Height="112"><local:HistoryChart x:Name="CpuChart" LineBrush="{ThemeResource CpuGraphBrush}"/></Grid>
        </StackPanel>
       </Border>
       <Border Grid.Column="1" Style="{StaticResource CardStyle}">
        <StackPanel Spacing="8">
         <Grid><TextBlock Text="内存" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock x:Name="MemoryValue" Text="—" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
         <TextBlock x:Name="MemoryDetail" Text="物理内存" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
         <Grid Height="112"><local:HistoryChart x:Name="MemoryChart" LineBrush="{ThemeResource MemoryGraphBrush}"/></Grid>
        </StackPanel>
       </Border>
       <Border Grid.Row="1" Style="{StaticResource CardStyle}">
        <StackPanel Spacing="8">
         <Grid><TextBlock Text="GPU" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock x:Name="GpuValue" Text="—" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
         <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="GpuName" Text="型号读取中" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="GpuTemperature" Grid.Column="1" Text="— °C" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
         </Grid>
         <Grid Height="112"><local:HistoryChart x:Name="GpuChart" LineBrush="{ThemeResource GpuGraphBrush}"/></Grid>
         <TextBlock x:Name="GpuDetail" Text="功耗 — W · 频率 — MHz" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
       </Border>
       <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}">
        <StackPanel Spacing="8">
         <Grid><TextBlock Text="电池" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock x:Name="BatteryValue" Text="—" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
         <TextBlock x:Name="BatteryDetail" Text="电量 · 供电状态" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
         <Grid Height="112"><local:HistoryChart x:Name="BatteryChart" LineBrush="{ThemeResource BatteryGraphBrush}"/></Grid>
        </StackPanel>
       </Border>
      </Grid>
      <Border Style="{StaticResource CardStyle}" Padding="24,20">
       <StackPanel Spacing="10">
        <TextBlock Text="风扇转速" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
        <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel Spacing="6"><Grid><TextBlock Text="CPU 风扇" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="CpuFanValue" Text="—" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid><local:HistoryChart x:Name="CpuFanChart" Height="96" LineBrush="{ThemeResource CpuGraphBrush}"/></StackPanel>
         <StackPanel Grid.Column="1" Spacing="6"><Grid><TextBlock Text="GPU 风扇" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="GpuFanValue" Text="—" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid><local:HistoryChart x:Name="GpuFanChart" Height="96" LineBrush="{ThemeResource GpuGraphBrush}"/></StackPanel>
        </Grid>
        <TextBlock x:Name="FanState" Text="只读通道连接中" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
       </StackPanel>
      </Border>
     </StackPanel>
     <StackPanel x:Name="DevicePanel" Visibility="Collapsed"><local:HardwarePage x:Name="HardwareDetails"/></StackPanel>
     <StackPanel x:Name="FanPanel" Visibility="Collapsed"><local:FanPage x:Name="Fans"/></StackPanel>
     <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Spacing="24" MaxWidth="1040" HorizontalAlignment="Stretch">
 <StackPanel Spacing="10"><TextBlock Text="个性化" Style="{ThemeResource BodyStrongTextBlockStyle}"/><Border Style="{StaticResource CardStyle}" Padding="0"><StackPanel><Grid ColumnSpacing="16" RowSpacing="8" Padding="20,18" SizeChanged="SettingsRowSizeChanged"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><FontIcon Glyph="&#xE790;" FontSize="19" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="应用主题" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock  Text="选择适合你的外观，主窗口与托盘同步。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><Grid Grid.Column="2" VerticalAlignment="Center"><ComboBox x:Name="ThemeChooser" AutomationProperties.Name="应用主题" Width="160" SelectedIndex="0" SelectionChanged="ThemeChanged"><ComboBoxItem Content="跟随 Windows"/><ComboBoxItem Content="浅色"/><ComboBoxItem Content="深色"/></ComboBox></Grid></Grid></StackPanel></Border></StackPanel>
 <StackPanel Spacing="10"><TextBlock Text="启动与后台" Style="{ThemeResource BodyStrongTextBlockStyle}"/><Border Style="{StaticResource CardStyle}" Padding="0"><StackPanel><Grid ColumnSpacing="16" RowSpacing="8" Padding="20,18" SizeChanged="SettingsRowSizeChanged"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><FontIcon Glyph="&#xE7E8;" FontSize="19" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="开机自启动" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock x:Name="StartupDescription" Text="登录 Windows 后在托盘运行。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><Grid Grid.Column="2" VerticalAlignment="Center"><ToggleSwitch x:Name="StartupToggle" Toggled="StartupToggled" AutomationProperties.Name="开机自启动" OffContent="关闭" OnContent="开启"/></Grid></Grid></StackPanel></Border></StackPanel>
 <StackPanel Spacing="10"><Grid><TextBlock Text="数据监测" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock Text="更改立即生效" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/></Grid><Border Style="{StaticResource CardStyle}" Padding="0"><StackPanel><Grid ColumnSpacing="16" RowSpacing="8" Padding="20,18" SizeChanged="SettingsRowSizeChanged"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><FontIcon Glyph="&#xE9D9;" FontSize="19" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="系统与显卡" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock  Text="CPU、内存、电池与 NVIDIA 指标。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><Grid Grid.Column="2" VerticalAlignment="Center"><ComboBox x:Name="SystemFrequencyChooser" AutomationProperties.Name="系统与显卡采样间隔" Width="160" SelectedIndex="1" SelectionChanged="FrequencyChanged"><ComboBoxItem Content="250 毫秒"/><ComboBoxItem Content="500 毫秒"/><ComboBoxItem Content="1 秒"/><ComboBoxItem Content="2 秒"/></ComboBox></Grid></Grid><Border Height="1" Margin="20,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/><Grid ColumnSpacing="16" RowSpacing="8" Padding="20,18" SizeChanged="SettingsRowSizeChanged"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><FontIcon Glyph="&#xE823;" FontSize="19" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="温度与风扇" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock  Text="独立采样，较长间隔可减少后台读取。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><Grid Grid.Column="2" VerticalAlignment="Center"><ComboBox x:Name="ThermalFrequencyChooser" AutomationProperties.Name="温度与风扇采样间隔" Width="160" SelectedIndex="0" SelectionChanged="FrequencyChanged"><ComboBoxItem Content="1 秒"/><ComboBoxItem Content="2 秒"/><ComboBoxItem Content="5 秒"/></ComboBox></Grid></Grid></StackPanel></Border><TextBlock x:Name="SamplingSummary" Text="当前采样频率" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
 <StackPanel Spacing="10"><TextBlock Text="诊断与应用" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
 <Button x:Name="ChannelsButton" Click="ChannelsClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20,18"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE71B;" FontSize="19" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="读取通道" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock  Text="数据来源、接口状态与本机驱动库" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center"/></Grid></Button>
 <Button x:Name="AboutButton" Click="AboutClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="20,18"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE946;" FontSize="19" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="关于 KClevoPanel" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock  Text="版本、适配设备与技术致谢" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center"/></Grid></Button></StackPanel>
 <TextBlock Text="设置保存在本机 · 自启动不会自动应用控制设置" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="2,0"/>
</StackPanel>
     <StackPanel x:Name="ChannelsPanel" Visibility="Collapsed" Spacing="16" MaxWidth="1040" HorizontalAlignment="Stretch"><Button Click="BackToSettingsClicked" Background="Transparent" BorderThickness="0" Padding="10,7"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72B;" FontSize="12"/><TextBlock Text="返回设置"/></StackPanel></Button><Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="本机数据来源" Style="{ThemeResource SubtitleTextBlockStyle}"/><TextBlock Text="系统：Windows API · 显卡：NVIDIA NVML · 温度与风扇：独立只读进程" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="此页面仅展示读取状态，不执行硬件写入。" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/></StackPanel></Border><Border Style="{StaticResource CardStyle}"><TextBlock x:Name="ChannelDetails" Text="正在读取通道信息…" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12"/></Border></StackPanel>
     <StackPanel x:Name="AboutPanel" Visibility="Collapsed" Spacing="16" MaxWidth="1040" HorizontalAlignment="Stretch">
 <Button Click="BackToSettingsClicked" Padding="10,7" Background="Transparent" BorderThickness="0"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72B;" FontSize="12"/><TextBlock Text="返回设置"/></StackPanel></Button>
 <Border Style="{StaticResource CardStyle}" Padding="28"><StackPanel Spacing="22">
 <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="64" Height="64" CornerRadius="17" Background="{ThemeResource AccentFillColorDefaultBrush}"><Viewbox Width="36" Height="36"><Path Data="M1,18 L10,18 L15,4 L23,33 L29,18 L35,18" Stroke="{ThemeResource TextOnAccentFillColorPrimaryBrush}" StrokeThickness="2.5" StrokeLineJoin="Round"/></Viewbox></Border><StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center"><TextBlock Text="KClevoPanel" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="看见每一次负载，调节每一份风量。" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid>
 <StackPanel Orientation="Horizontal" Spacing="8"><Border Padding="10,5" CornerRadius="5" Background="{ThemeResource AccentFillColorDefaultBrush}"><TextBlock x:Name="AboutVersion" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/></Border><Border Padding="10,5" CornerRadius="5" Background="{ThemeResource ControlFillColorSecondaryBrush}"><TextBlock Text="WinUI 3" FontSize="11"/></Border><Border Padding="10,5" CornerRadius="5" Background="{ThemeResource ControlFillColorSecondaryBrush}"><TextBlock Text="Windows · x64" FontSize="11"/></Border></StackPanel>
 <TextBlock Text="为 COLORFUL X17 打造的原生设备面板。性能、温度与风扇清晰呈现，在主窗口与托盘之间随时切换。" FontSize="14" LineHeight="23" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
 </StackPanel></Border>
 <Grid x:Name="AboutFeatures" ColumnSpacing="16" RowSpacing="16" SizeChanged="AboutFeaturesSizeChanged"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Border Style="{StaticResource CardStyle}" Padding="22"><StackPanel Spacing="10"><FontIcon Glyph="&#xE9D9;" FontSize="22" HorizontalAlignment="Left" Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/><TextBlock Text="状态，一目了然" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock  Text="60 秒实时曲线、独立采样与托盘速览，让变化清晰可见。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Border>
 <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="22"><StackPanel Spacing="10"><FontIcon Glyph="&#xE72E;" FontSize="22" HorizontalAlignment="Left" Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/><TextBlock Text="数据，留在本机" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock  Text="不上传设备数据，不读取硬件序列号。设置与曲线草稿保存在本机。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Border></Grid>
 <Border Style="{StaticResource CardStyle}" Padding="22"><StackPanel Spacing="14"><TextBlock Text="为这台设备而构建" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock Text="COLORFUL X17 AT 23H2" FontSize="20" FontWeight="SemiBold"/><TextBlock  Text="Intel Core i7-13650HX · NVIDIA RTX 4060 Laptop" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/><Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/><TextBlock  Text="使用现有 ACPI 驱动提供监测与已验证的固件控制。当前适配有明确的机型与接口限制，不包含原厂预设的完整 GPU 和 Windows 电源联动。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Border>
 <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><Expander.Header><TextBlock Text="技术与致谢" Style="{ThemeResource BodyStrongTextBlockStyle}"/></Expander.Header><StackPanel Spacing="12"><TextBlock  Text="基于 .NET 8 与 Microsoft Windows App SDK / WinUI 3 构建。显卡指标由 NVIDIA NVML 提供。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/><TextBlock  Text="感谢 Clevo-X370-Control-Center 项目提供的公开研究参考。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/><HyperlinkButton Content="查看参考项目" NavigateUri="https://github.com/jiyeguang25/Clevo-X370-Control-Center" HorizontalAlignment="Left" Padding="0,4"/><TextBlock  Text="本项目与 CLEVO、COLORFUL、Microsoft 无隶属或官方背书关系。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Expander>
 <TextBlock Text="原生 Windows 体验 · 本机数据处理" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,8"/>
</StackPanel>
    </StackPanel>
   </ScrollViewer>
  </NavigationView>
 </Grid>
</Window>
