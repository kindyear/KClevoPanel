<UserControl x:Class="KClevoPanel.App.HardwarePage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel x:Name="PageRoot" Spacing="20">
  <StackPanel.Resources>
   <Style x:Key="HardwareCard" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="22"/>
   </Style>
   <Style x:Key="SecondaryText" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
   <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
   <Style x:Key="FieldValue" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="IsTextSelectionEnabled" Value="True"/></Style>
   <Style x:Key="CategoryIcon" TargetType="FontIcon"><Setter Property="Foreground" Value="{ThemeResource SystemControlHighlightAccentBrush}"/><Setter Property="FontSize" Value="20"/></Style>
   <Style x:Key="BadgeBorder" TargetType="Border"><Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}"/><Setter Property="Padding" Value="8,3"/><Setter Property="CornerRadius" Value="4"/></Style>
  </StackPanel.Resources>
  <Border Style="{StaticResource HardwareCard}" Padding="24">
   <Grid ColumnSpacing="20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Width="76" Height="76" CornerRadius="12" Background="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center">
     <FontIcon Glyph="&#xE7F8;" FontSize="40" Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/>
    </Border>
    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
     <TextBlock Text="我的电脑" Style="{StaticResource SecondaryText}"/>
     <TextBlock x:Name="DeviceModel" Text="此电脑" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
     <TextBlock x:Name="DeviceBrand" Text="正在读取设备档案…" Style="{StaticResource SecondaryText}"/>
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
     <Button Click="CopyClicked" ToolTipService.ToolTip="复制硬件清单" AutomationProperties.Name="复制硬件清单"><FontIcon Glyph="&#xE8C8;" FontSize="16"/></Button>
     <Button Click="ExportClicked" ToolTipService.ToolTip="导出硬件 JSON" AutomationProperties.Name="导出硬件 JSON"><FontIcon Glyph="&#xE74E;" FontSize="16"/></Button>
    </StackPanel>
   </Grid>
  </Border>
  <Grid ColumnSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource HardwareCard}" Padding="18,16"><StackPanel Spacing="8"><TextBlock Text="处理器" Style="{StaticResource SecondaryText}"/><TextBlock x:Name="CpuSummary" Text="—" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="核心 / 逻辑处理器" Style="{StaticResource SecondaryText}"/></StackPanel></Border>
   <Border Grid.Column="1" Style="{StaticResource HardwareCard}" Padding="18,16"><StackPanel Spacing="8"><TextBlock Text="已安装内存" Style="{StaticResource SecondaryText}"/><TextBlock x:Name="MemorySummary" Text="—" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="MemoryCount" Text="内存模块读取中" Style="{StaticResource SecondaryText}"/></StackPanel></Border>
   <Border Grid.Column="2" Style="{StaticResource HardwareCard}" Padding="18,16"><StackPanel Spacing="8"><TextBlock Text="本地存储" Style="{StaticResource SecondaryText}"/><TextBlock x:Name="StorageSummary" Text="—" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="StorageCount" Text="物理磁盘读取中" Style="{StaticResource SecondaryText}"/></StackPanel></Border>
  </Grid>
  <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Spacing="5"><TextBlock Text="硬件配置" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="查看型号与规格，展开卡片了解详细参数。" Style="{StaticResource SecondaryText}"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><ProgressRing x:Name="LoadingRing" IsActive="False" Width="18" Height="18"/><TextBlock x:Name="ReadStatus" Text="准备读取" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/></StackPanel>
  </Grid>
  <InfoBar x:Name="HardwareError" IsOpen="False" Visibility="Collapsed" IsClosable="True" Severity="Warning" Title="部分硬件信息暂不可用"/>
  <Grid x:Name="CardsHost" ColumnSpacing="16" RowSpacing="16" SizeChanged="CardsSizeChanged"/>
  <Expander x:Name="BridgeSection" Header="ACPI 桥驱动" Visibility="Collapsed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel x:Name="BridgeDrivers" Spacing="12"/></Expander>
  <TextBlock x:Name="ActionStatus" Style="{StaticResource SecondaryText}" IsTextSelectionEnabled="True"/>
 </StackPanel>
</UserControl>
